[
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Your name as displayed on the website (e.g. Dr. Lohith J.J.)",
        "name": "name",
        "type": "string",
        "title": "Full Name"
      },
      {
        "description": "Short degree/institution tag shown next to name (e.g. Ph.D. (NIT Trichy))",
        "name": "credential",
        "type": "string",
        "title": "Academic Credential Tag"
      },
      {
        "description": "Main designation line under your name (e.g. Professor & Head of Department — CSE(IOT & Cybersecurity including Blockchain technology))",
        "name": "designation",
        "type": "string",
        "title": "Current Job Title / Eyebrow"
      },
      {
        "description": "Total years in academia and research (e.g. 19)",
        "name": "yearsExperience",
        "type": "number",
        "title": "Years of Experience"
      },
      {
        "rows": 3,
        "description": "First paragraph of your homepage intro bio",
        "name": "heroDescriptionLine1",
        "type": "text",
        "title": "Hero Bio — Paragraph 1"
      },
      {
        "rows": 3,
        "description": "Second paragraph of your homepage intro bio",
        "name": "heroDescriptionLine2",
        "type": "text",
        "title": "Hero Bio — Paragraph 2"
      },
      {
        "options": {
          "hotspot": true
        },
        "description": "High resolution headshot photo displayed on top right of hero section",
        "name": "profilePhoto",
        "type": "image"
      },
      {
        "description": "e.g. Nagarjuna College of Engineering & Technology, Bengaluru",
        "name": "currentInstitution",
        "type": "string"
      },
      {
        "name": "emailPrimary",
        "type": "string",
        "title": "Primary Email"
      },
      {
        "name": "emailSecondary",
        "type": "string",
        "title": "Secondary Email (e.g. WILP Email)"
      },
      {
        "name": "phone",
        "type": "string",
        "title": "Phone Number"
      },
      {
        "name": "address",
        "type": "string",
        "title": "Location / Address"
      },
      {
        "description": "List of guest faculty and advisory roles (e.g. Guest Faculty at BITS WILP Programme)",
        "of": [
          {
            "type": "string"
          }
        ],
        "name": "additionalRoles",
        "type": "array",
        "title": "Additional Academic Roles"
      },
      {
        "description": "List of society memberships (e.g. Computer Society of India (CSI) — Life Member)",
        "of": [
          {
            "type": "string"
          }
        ],
        "name": "professionalMemberships",
        "type": "array"
      }
    ],
    "name": "profile",
    "type": "document",
    "title": "Profile & Hero Bio"
  },
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "e.g. Ph.D. in Computer Science",
        "name": "degree",
        "type": "string",
        "title": "Degree / Qualification"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "e.g. National Institute of Technology (NIT), Tiruchirappalli",
        "name": "institution",
        "type": "string",
        "title": "University / Institution"
      },
      {
        "description": "e.g. 2017 — 2024",
        "name": "year",
        "type": "string",
        "title": "Year Range"
      },
      {
        "rows": 2,
        "description": "Thesis title or grade details (e.g. Thesis: \"Blockchain-Based Smart Contract Security...\")",
        "name": "thesis",
        "type": "text",
        "title": "Thesis / Specialization Details"
      },
      {
        "initialValue": 10,
        "description": "Lower numbers display first (1 = top)",
        "name": "order",
        "type": "number",
        "title": "Display Order"
      }
    ],
    "name": "education",
    "type": "document"
  },
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "e.g. Professor & Head, Dept. of IoT & CyberSecurity including Blockchain Technology",
        "name": "role",
        "type": "string",
        "title": "Job Position / Role"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "e.g. Nagarjuna College of Engineering & Technology, Bengaluru",
        "name": "organization",
        "type": "string",
        "title": "College / Organization"
      },
      {
        "description": "e.g. June 2026 or Aug 2009",
        "name": "startYear",
        "type": "string",
        "title": "Start Date / Year"
      },
      {
        "description": "e.g. Present or May 2024",
        "name": "endYear",
        "type": "string",
        "title": "End Date / Year"
      },
      {
        "initialValue": false,
        "name": "isCurrent",
        "type": "boolean",
        "title": "Currently Working Here?"
      },
      {
        "initialValue": 10,
        "description": "Lower numbers display first (1 = latest position at the top)",
        "name": "order",
        "type": "number",
        "title": "Display Order"
      }
    ],
    "name": "experience",
    "type": "document",
    "title": "Employment Experience"
  },
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "name": "title",
        "type": "string",
        "title": "Paper Title"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "e.g. L. J.J. and K. Singh",
        "name": "authors",
        "type": "string",
        "title": "Authors List"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "e.g. International Journal of Information Technology, vol. 16(6), pp. 3389–3399",
        "name": "venue",
        "type": "string",
        "title": "Journal / Conference Name & Volume"
      },
      {
        "options": {
          "list": [
            {
              "title": "SCIE / Scopus Journal",
              "value": "journal"
            },
            {
              "title": "IEEE Conference Proceeding",
              "value": "conference"
            },
            {
              "title": "Book Chapter / Textbook",
              "value": "book"
            }
          ],
          "layout": "radio"
        },
        "initialValue": "journal",
        "validation": [
          {
            "rules": [
              {
                "flag": "valid",
                "constraint": [
                  "journal",
                  "conference",
                  "book"
                ]
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "name": "publicationType",
        "type": "string"
      },
      {
        "description": "e.g. 2024",
        "name": "year",
        "type": "number",
        "title": "Year of Publication"
      },
      {
        "description": "e.g. https://doi.org/10.1007/s41870-024-01909-8",
        "name": "doi",
        "type": "string",
        "title": "DOI URL or Number"
      },
      {
        "options": {
          "accept": ".pdf"
        },
        "description": "Single-click PDF upload directly from your computer",
        "name": "pdfFile",
        "type": "file",
        "title": "Upload Full Paper PDF"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "uri",
                "constraint": {
                  "options": {
                    "scheme": [
                      "/^http$/",
                      "/^https$/"
                    ],
                    "allowRelative": false,
                    "relativeOnly": false,
                    "allowCredentials": false
                  }
                }
              }
            ],
            "level": "error"
          }
        ],
        "name": "externalLink",
        "type": "url",
        "title": "External Link / Publisher URL"
      },
      {
        "description": "e.g. J1, J2, C1, C2",
        "name": "codeNumber",
        "type": "string",
        "title": "Paper Code Number"
      },
      {
        "initialValue": false,
        "name": "featured",
        "type": "boolean",
        "title": "Featured Paper"
      },
      {
        "initialValue": 10,
        "name": "order",
        "type": "number",
        "title": "Display Order"
      }
    ],
    "name": "publication",
    "type": "document",
    "title": "Publications & Papers"
  },
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }

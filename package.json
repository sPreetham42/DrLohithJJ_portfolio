{
    "name": "dr-lohith-portfolio",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
    "dev": "wrangler dev worker/index.ts",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "build:admin": "vite build admin",
    "build:site": "node scripts/build_unified_site.js",
    "build": "npm run build:admin && npm run build:site",
    "deploy": "npm run build && wrangler deploy"
  },
    "dependencies": {
        "lucide-react": "^1.32.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20240815.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "typescript": "^5.5.4",
        "vite": "^8.2.1",
        "wrangler": "^3.72.0"
    }
}

{
  "name": "dr-lohith-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot:validate": "node migration/validate_snapshot.js",
    "snapshot:normalize": "node migration/normalize_snapshot.js",
    "snapshot:manifest": "node migration/generate_manifest.js",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "db:import:dry-run": "node migration/import_d1.js --dry-run",
    "db:import": "node migration/import_d1.js",
    "test:phase1": "node migration/test_suite_phase1.js",
    "test:phase2": "node worker/test_suite_phase2.js",
    "test:phase3": "node admin/test_suite_phase3.js",
    "test:phase4": "node scripts/test_suite_phase4.js",
    "test:phase5": "node scripts/test_suite_phase5.js",
    "test:phase6": "node scripts/test_suite_phase6.js",
    "build:admin": "vite build admin",

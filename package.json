  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240815.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.5.4",
    "vite": "^8.2.1",
    "wrangler": "^3.72.0"
  }
